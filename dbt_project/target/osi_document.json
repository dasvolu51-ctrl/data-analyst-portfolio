{"version": "0.1.1", "dialects": ["ANSI_SQL"], "semantic_model": [{"name": "semantic_model", "datasets": [{"name": "metricflow_time_spine", "source": "\"saas_metrics\".\"main\".\"metricflow_time_spine\"", "primary_key": ["date_day"], "description": "Time spine table for MetricFlow semantic resolution", "fields": [{"name": "time_spine_key", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "date_day"}]}}, {"name": "date_day", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "date_day"}]}, "dimension": {"is_time": true}}]}, {"name": "subscription_events", "source": "\"saas_metrics\".\"main\".\"fct_subscription_events\"", "primary_key": ["sub_id"], "fields": [{"name": "customer", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "customer_id"}]}}, {"name": "subscription", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "sub_id"}]}}, {"name": "snapshot_month", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "snapshot_month"}]}, "dimension": {"is_time": true}}, {"name": "plan_name", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "plan_name"}]}, "dimension": {"is_time": false}}, {"name": "mrr_amount", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "mrr_amount"}]}}, {"name": "active_subscriber_count", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "customer_id"}]}}]}], "metrics": [{"name": "mrr", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "SUM(subscription_events.mrr_amount)"}]}, "description": "Monthly Recurring Revenue"}, {"name": "active_subscribers", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "COUNT(DISTINCT subscription_events.customer_id)"}]}, "description": "Count of distinct active subscribers"}]}]}